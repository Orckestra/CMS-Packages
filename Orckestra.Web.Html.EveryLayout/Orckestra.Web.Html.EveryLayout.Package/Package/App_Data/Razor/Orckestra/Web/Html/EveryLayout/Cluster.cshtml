@inherits RazorFunction

@functions {
    public override string FunctionDescription
    {
        get  { return "CLUSTER - Layout component for grouping items, with control over the margin between them."; }
    }
	
	public static WidgetFunctionProvider GetGapWidget()
    {
        Expression<Func<object>> expression = () => GetGapOptions();
        var method = (expression.Body as MethodCallExpression).Method;

        return StandardWidgetFunctions.DropDownList(method.DeclaringType, method.Name, "Value", "Key", false);
    }

    public static Dictionary<string, string> GetGapOptions()
    {
        var options = new Dictionary<string, string>();

        options.Add("-5 (0.33rem - 0.18rem)", "var(--s-5)");
        options.Add("-4 (0.41rem - 0.25rem)", "var(--s-4)");
        options.Add("-3 (0.51rem - 0.35rem)", "var(--s-3)");
        options.Add("-2 (0.64rem - 0.5rem)", "var(--s-2)");
        options.Add("-1 (0.8rem - 0.71rem)", "var(--s-1)");
        options.Add("0 (1rem)", "var(--s0)");
		options.Add("1 (1.25rem - 1.41rem)", "var(--s1)");
		options.Add("2 (1.56rem - 2rem)", "var(--s2)");
		options.Add("3 (1.95rem - 2.83rem)", "var(--s3)");
		options.Add("4 (2.44rem - 4rem)", "var(--s4)");
		options.Add("5 (3.05rem - 5.65rem)", "var(--s5)");

        return options;
    }
	
	public static WidgetFunctionProvider GetHorizontalSpacingWidget()
    {
        Expression<Func<object>> expression = () => GetHorizontalSpacingOptions();
        var method = (expression.Body as MethodCallExpression).Method;

        return StandardWidgetFunctions.DropDownList(method.DeclaringType, method.Name, "Value", "Key", false);
    }

    public static Dictionary<string, string> GetHorizontalSpacingOptions()
    {
        var options = new Dictionary<string, string>();

        options.Add("Left aligned", "flex-start");
        options.Add("Right aligned", "flex-end");
        options.Add("Centered", "center");
        options.Add("Space evenly distributed between items", "space-between");
        options.Add("Space evenly distributed before, between and after items", "space-evenly");

        return options;
    }
	
	public static WidgetFunctionProvider GetVerticalAlignmentWidget()
    {
        Expression<Func<object>> expression = () => GetVerticalAlignmentOptions();
        var method = (expression.Body as MethodCallExpression).Method;

        return StandardWidgetFunctions.DropDownList(method.DeclaringType, method.Name, "Value", "Key", false);
    }

    public static Dictionary<string, string> GetVerticalAlignmentOptions()
    {
        var options = new Dictionary<string, string>();

        options.Add("Top", "flex-start");
        options.Add("Bottom", "flex-end");
        options.Add("Centered", "center");
        options.Add("Stretched", "stretch");

        return options;
    }

    [FunctionParameter(Label = "Content to be presented as a cluster", Help = "")]
    public XhtmlDocument Content { get; set; }
	
	[FunctionParameter(Label = "Gap", Help = "Space between the items.", DefaultValue="var(--s-1)", WidgetFactoryMethod = "GetGapWidget")]
    public string Gap { get; set; }
	
	[FunctionParameter(Label = "Horizontal items distribution", Help = "", DefaultValue="flex-start", WidgetFactoryMethod = "GetHorizontalSpacingWidget")]
    public string JustifyContent { get; set; }
	
	[FunctionParameter(Label = "Items vertical aligment", Help = "", DefaultValue="flex-start", WidgetFactoryMethod = "GetVerticalAlignmentWidget")]
    public string AlignItems { get; set; }

    [FunctionParameter(Label = "Additional CSS classes", Help = "Add your own CSS classes for further customization.", DefaultValue = "")]
    public string CssClasses { get; set; }
	
	private string gapStyle()
    {
        return ((Gap != "var(--s-1)") ? "gap:" + Gap + ";" : "");
    }

    private string justifyContentStyle()
    {
        return (JustifyContent != "flex-start" ? "justify-content:" + JustifyContent + ";" : "");
    }

    private string alignItemsStyle()
    {
        return (AlignItems != "flex-start" ? "align-items:" + AlignItems + ";" : "");
    }

}

<html xmlns="http://www.w3.org/1999/xhtml" xmlns:f="http://www.composite.net/ns/function/1.0">
    <head>
		<link id="everylayout-common" rel="stylesheet" type="text/css" href="~/Frontend/Orckestra/Web/Html/EveryLayout/Common.css"/>
		<link id="everylayout-cluster" rel="stylesheet" type="text/css" href="~/Frontend/Orckestra/Web/Html/EveryLayout/Cluster.css"/>
    </head>
    <body>
        <div class="cluster-el @CssClasses" style="@gapStyle()@justifyContentStyle()@alignItemsStyle()">
            @Html.Raw(@Content)
        </div>
    </body>
</html>